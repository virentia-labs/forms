{
  "name": "@virentia/forms",
  "version": "0.2.3",
  "description": "Virentia-native form models",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virentia-labs/forms.git",
    "directory": "packages/forms"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./models": {
      "types": "./dist/models.d.mts",
      "import": "./dist/models.mjs",
      "require": "./dist/models.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run && vitest typecheck --run --passWithNoTests",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@virentia/core": ">=0.11.2"
  },
  "devDependencies": {
    "@virentia/core": "link:../../../virentia/packages/core"
  }
}
